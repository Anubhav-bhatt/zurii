# Local-only credentials for infra/local-db/compose.yml.
#
# Do not fill this in by hand. Run, from the repository root:
#
#   sh infra/local-db/bootstrap-env.sh
#
# which writes infra/local-db/.env (gitignored) with freshly generated values,
# plus backend/.env and backend/.env.test pointing at the two local databases.
# None of these values is ever valid anywhere except this machine's container.

ZURII_LOCAL_PG_PORT=55432
ZURII_LOCAL_PG_SUPERUSER_PASSWORD=
ZURII_DEV_DB_PASSWORD=
ZURII_TEST_DB_PASSWORD=
