# Copy to backend/.env, then fill in. NEVER commit the filled-in file.
#   cp .env.example .env
#
# This is what `npm start` and the scripts under scripts/ read. `npm test` does
# NOT use it — tests read backend/.env.test (see the end of this file).
# For the Docker Compose stack you want the ROOT .env.example instead —
# docker-compose.yml passes these values in as container environment.
#
# LOCAL DEVELOPMENT: do not fill this in by hand. From the repository root run
#   sh infra/local-db/bootstrap-env.sh
# which writes backend/.env (zurii_dev) and backend/.env.test (zurii_test) with
# generated local-only values. See docs/LOCAL_DEVELOPMENT.md.

# ── Database (REQUIRED) ────────────────────────────────────────────
# The server exits at startup if this is unset.
#   Cloud (Aiven/Supabase/Neon):
#     postgres://user:pass@host:port/dbname?sslmode=require
#   Local:
#     postgres://postgres@localhost:5432/zurii_db
# TLS is forced for any host that is not localhost/127.0.0.1 — see db/pool.js.
#
# Locally this is the isolated zurii_dev database. The test suite never uses
# DATABASE_URL: it runs only against TEST_DATABASE_URL (zurii_test), verified
# by backend/db/safety.js before anything is written.
DATABASE_URL=

# ── JWT (REQUIRED) ─────────────────────────────────────────────────
# The server exits at startup if either is unset. Generate each separately —
# never reuse one for both, and never reuse a development secret in production:
#   openssl rand -hex 48
# Rotating either one invalidates every access token (15m) and refresh
# cookie (7d) immediately, which is the intended way to cut off all sessions.
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Server ─────────────────────────────────────────────────────────
PORT=5001

# Keep `development` when serving over plain HTTP, including localhost.
# `production` marks the refresh cookie Secure, so a browser refuses to store
# it over HTTP and admin login silently fails to persist.
NODE_ENV=development

# ── Optional ───────────────────────────────────────────────────────
# Admin accounts created on first boot. Format: user:pass,user:pass
# Passwords must clear lib/validateAdminPassword.js (16+ chars, not a common
# default), and existing accounts are never overwritten. Prefer creating
# accounts with the CLI, which prompts without echo and forces a first-login
# password change:
#   node create-admin.js add <username>
ADMIN_SEED=

# Number of trusted reverse-proxy hops. Leave EMPTY when the backend is
# reachable directly: trusting X-Forwarded-For then lets any caller spoof
# their IP and walk past the rate limits. Set to 1 behind a single nginx.
TRUST_PROXY=

# Structured JSON logs (docs/OBSERVABILITY.md): debug | info | warn | error.
# Default info. Never logs passwords, tokens, cookies or form values.
# LOG_LEVEL=info

# Browser origins allowed to make credentialed API calls, comma-separated.
# Local dev ports are always allowed, so this can stay empty for development.
# REQUIRED once the SPA is served from its own domain. Never use `*`.
ALLOWED_ORIGINS=

# SameSite for the refresh cookie: lax (default) or none.
#
# Leave it as lax whenever the browser reaches this API on the SAME SITE it
# loaded the app from — the Docker image (nginx proxies /api/ to the backend),
# a single domain, or a frontend host that rewrites /api/* here.
#
# Set it to none ONLY when the SPA lives on a different site, e.g. the app on
# Vercel and this API on Render. A Lax cookie is not sent on cross-site
# requests, and the failure is silent: login succeeds, the dashboard works for
# fifteen minutes on the in-memory access token, then the session cannot be
# renewed and every reload lands on the login screen.
#
# `none` forces Secure, so it requires HTTPS on both ends. Prefer the
# same-origin arrangement where you can — it is the stronger position, because
# the cookie is then never sent from a third-party context at all.
COOKIE_SAMESITE=

# ── backend/.env.test (a SEPARATE, gitignored file — not this one) ──
# Read only by `npm test` (scripts/run-tests.mjs), which never falls back to
# DATABASE_URL and refuses any database other than a verified local zurii_test.
# Generated by infra/local-db/bootstrap-env.sh with these keys:
#   TEST_DATABASE_URL=postgres://zurii_test_app:<generated>@127.0.0.1:55432/zurii_test
#   DATABASE_SSL=disable
#   JWT_SECRET=<generated, test-only>
#   JWT_REFRESH_SECRET=<generated, test-only>
