# Copy to backend/.env, then fill in. NEVER commit the filled-in file.
#   cp .env.example .env
#
# This is what `npm start`, `npm test` and every script under scripts/ read.
# For the Docker Compose stack you want the ROOT .env.example instead —
# docker-compose.yml passes these values in as container environment.

# ── Database (REQUIRED) ────────────────────────────────────────────
# The server exits at startup if this is unset.
#   Cloud (Aiven/Supabase/Neon):
#     postgres://user:pass@host:port/dbname?sslmode=require
#   Local:
#     postgres://postgres@localhost:5432/zurii_db
# TLS is forced for any host that is not localhost/127.0.0.1 — see db/pool.js.
#
# Point this at a DEVELOPMENT database. The test suite writes: it creates and
# deletes admins, bookings, contacts and analytics rows.
DATABASE_URL=

# ── JWT (REQUIRED) ─────────────────────────────────────────────────
# The server exits at startup if either is unset. Generate each separately —
# never reuse one for both, and never reuse a development secret in production:
#   openssl rand -hex 48
# Rotating either one invalidates every access token (15m) and refresh
# cookie (7d) immediately, which is the intended way to cut off all sessions.
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Server ─────────────────────────────────────────────────────────
PORT=5001

# Keep `development` when serving over plain HTTP, including localhost.
# `production` marks the refresh cookie Secure, so a browser refuses to store
# it over HTTP and admin login silently fails to persist.
NODE_ENV=development

# ── Optional ───────────────────────────────────────────────────────
# Admin accounts created on first boot. Format: user:pass,user:pass
# Passwords must clear lib/validateAdminPassword.js (16+ chars, not a common
# default), and existing accounts are never overwritten. Prefer creating
# accounts with the CLI, which prompts without echo and forces a first-login
# password change:
#   node create-admin.js add <username>
ADMIN_SEED=

# Number of trusted reverse-proxy hops. Leave EMPTY when the backend is
# reachable directly: trusting X-Forwarded-For then lets any caller spoof
# their IP and walk past the rate limits. Set to 1 behind a single nginx.
TRUST_PROXY=

# Browser origins allowed to make credentialed API calls, comma-separated.
# Local dev ports are always allowed, so this can stay empty for development.
# REQUIRED once the SPA is served from its own domain. Never use `*`.
ALLOWED_ORIGINS=

# Source database for migrate.js only.
# Defaults to postgresql://postgres@localhost:5432/postgres if unset.
# LOCAL_DB_URL=
