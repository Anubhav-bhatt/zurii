# CRITICAL: node_modules is committed to this repo but is stale and
# platform-specific (bcrypt ships native binaries). Copying it in would
# shadow the clean `npm ci` layer and crash on missing/incompatible modules.
node_modules
npm-debug.log*

# Secrets never belong in an image — env is injected at runtime.
.env
.env.*

.git
.gitignore
Dockerfile
.dockerignore
*.md
.DS_Store

# Tests are not needed at runtime. They also connect to a real database, so
# keeping them out of the production image removes any chance of running them
# against production data from inside the container.
tests
*.test.mjs
*.test.js
