# ── Zurii frontend — build-time configuration ────────────────────────
#
#   cp .env.example .env
#
# Only needed for running the SPA directly with `npm run dev` / `npm run build`
# outside Docker. The Docker image takes VITE_API_URL as a build argument from
# the ROOT .env instead (see docker-compose.yml), so a deployment never uses
# this file.
#
# ─────────────────────────────────────────────────────────────────────
# EVERYTHING HERE IS PUBLIC.
# ─────────────────────────────────────────────────────────────────────
#
# Vite substitutes VITE_* variables into the JavaScript bundle at BUILD time.
# Whatever you put here is shipped to every visitor's browser and readable with
# View Source. There is no such thing as a secret in this file.
#
# NEVER put here:
#   - a database password or connection string
#   - JWT_SECRET or JWT_REFRESH_SECRET
#   - an admin password
#   - any private API key or backend service credential
#
# A backend API URL is fine — it is public by nature.

# Backend origin used by src/config/api.js.
#
#   unset          → http://localhost:5001 (the local `npm run dev` default)
#   empty string   → same-origin relative /api/... calls, which is what the
#                    Docker image uses because nginx proxies /api to the backend
#   absolute URL   → that origin, when the backend is hosted on another domain
#
# Note the distinction: unset and empty behave differently on purpose.
VITE_API_URL=http://localhost:5001
