# ── Zurii Travels — deployment configuration ─────────────────────────
#
#   cp .env.example .env
#
# Then fill in the blanks below. Docker Compose reads this file automatically.
#
# Every secret below is intentionally EMPTY. Nothing in this repository ships a
# working password, key or connection string, so there is no default credential
# to forget to change. A blank required value fails the deploy immediately with
# a message naming the variable — that is the intended behaviour, not a bug.
#
# .env is gitignored. Never commit it, never paste it into a ticket or a chat,
# never screenshot it.
#
# ─────────────────────────────────────────────────────────────────────
# SECTION 1 — PRIVATE. Server-side only. Never reaches a browser.
# ─────────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────────
#
# Choose ONE topology.
#
# A. BUNDLED PostgreSQL container (the `db` service). Leave DATABASE_URL empty
#    and set POSTGRES_PASSWORD; the connection string is composed for you.
#    Start with:  docker compose up -d --build
#
# B. EXTERNAL / managed PostgreSQL (Aiven, Neon, Supabase, RDS). Set
#    DATABASE_URL to the provider's string; it overrides topology A entirely
#    and POSTGRES_* are then unused.
#    Start with:  docker compose up -d --build --no-deps backend frontend

# Topology A only. Use URL-safe characters: this value is interpolated into a
# postgres:// string, so @ : / ? # would corrupt it.
# Generate one with:  openssl rand -hex 24
POSTGRES_USER=zurii
POSTGRES_DB=zurii
POSTGRES_PASSWORD=

# Topology B only. Leave EMPTY for topology A.
# Format: postgresql://USER:PASSWORD@HOST:5432/DATABASE_NAME
#
# The host must be reachable FROM THE CONTAINER. Inside Docker `localhost`
# means the container itself, so it can never reach a database on your host or
# in another container — use the Compose service name (`db`) or the provider's
# public hostname.
DATABASE_URL=

# TLS for the database connection: verify | no-verify | disable
#
#   verify     Encrypt AND authenticate the server. Correct for production.
#              Managed providers use their own CA, so this normally also needs
#              DATABASE_CA_CERT.
#   no-verify  Encrypt only. Stops passive capture but cannot detect an
#              interceptor. Use when the provider offers no CA bundle.
#   disable    No TLS. Only for a database on a private network.
#
# Empty keeps the compatible default: off for localhost, encrypted-but-
# unverified for every other host. The backend warns at startup if production
# is running unverified.
DATABASE_SSL=
# Path to a CA bundle inside the container, or the PEM text itself. Only used
# when DATABASE_SSL=verify.
DATABASE_CA_CERT=

# ── Authentication secrets (REQUIRED) ────────────────────────────────
#
# Generate each one SEPARATELY. They must be different values: reusing one
# means a captured 7-day refresh token is also a valid access token.
#
#   openssl rand -hex 48
#
# Rotating either immediately invalidates every session — that is the intended
# way to cut off all admin access. Minimum 32 characters, enforced at startup.
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── CORS (REQUIRED in production) ────────────────────────────────────
#
# Browser origins allowed to make credentialed API calls, comma-separated.
# Bare origins only — scheme and host, no trailing path:
#   ALLOWED_ORIGINS=https://zurii.example,https://www.zurii.example
#
# Never `*`: this API serves credentialed admin requests, and a wildcard cannot
# be combined with credentials. In production localhost dev origins are NOT
# trusted, so this must name your real domain even though nginx proxies /api on
# the same origin.
ALLOWED_ORIGINS=

# ── Admin bootstrap (OPTIONAL — prefer leaving this EMPTY) ───────────
#
# The recommended way to create the first admin does not use this variable:
#
#   docker compose exec backend node create-admin.js add <username>
#
# That prompts for the password with echo disabled, so it never enters your
# shell history, the environment, or this file.
#
# ADMIN_SEED exists only for automated first-boot provisioning. Its password
# sits in an environment variable readable by any process on the host, and in
# whatever file or secret store supplied it. Format: "user:password" (comma-
# separated for several). Passwords must clear the same policy the CLI enforces
# (16+ characters, not a common default) or the account is refused, loudly.
#
# Either way the account MUST change its password at first login and can reach
# nothing else until it does. Unset this once the account exists.
ADMIN_SEED=

# ─────────────────────────────────────────────────────────────────────
# SECTION 2 — RUNTIME
# ─────────────────────────────────────────────────────────────────────

# Keep `development` when serving over plain HTTP, including localhost.
# `production` marks the refresh cookie Secure, so browsers refuse to store it
# over HTTP and admin login silently fails to persist. Switch to `production`
# only once TLS terminates in front of this stack.
NODE_ENV=development

# Host port for the web UI.
WEB_PORT=8080

# ─────────────────────────────────────────────────────────────────────
# SECTION 3 — PUBLIC. Compiled into the browser bundle by Vite.
# ─────────────────────────────────────────────────────────────────────
#
# EVERYTHING with a VITE_ prefix is readable by anyone who loads the site.
# Vite substitutes these at BUILD time into the JavaScript it emits — they are
# not runtime configuration and they are not secret.
#
# NEVER put a database password, a JWT signing secret, an admin password or a
# private API key here. If a value must stay secret, it belongs in Section 1
# and must be used only by the backend.

# Leave EMPTY so the SPA calls same-origin /api/* and nginx proxies it — the
# recommended setup, and the reason this stack needs no CORS configuration for
# ordinary page loads. Set an absolute URL (https://api.example.com) only when
# the backend runs on a different origin. Baked in at image build time, so
# changing it requires: docker compose build frontend
VITE_API_URL=
