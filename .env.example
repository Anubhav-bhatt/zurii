# Copy to .env (same directory as docker-compose.yml), then fill in.
#   cp .env.example .env
# Compose reads this file automatically. It is gitignored — never commit .env.

# ── Database ───────────────────────────────────────────────────────
POSTGRES_USER=zurii
POSTGRES_DB=zurii
# Use only URL-safe characters. This value is interpolated into a
# postgres:// connection string, so @ : / ? # would corrupt it.
POSTGRES_PASSWORD=

# ── JWT secrets (required — backend exits at startup if unset) ──────
# Generate each with:  openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Admin panel logins ─────────────────────────────────────────────
# Accounts created on first boot. Format: user:pass,user:pass
# Choose your own — these are the credentials for /admin.
# Passwords must be at least 16 characters and must not be a common default;
# the admin CLI enforces the same policy.
# Existing accounts are never overwritten; to change a password later run:
#   docker compose exec backend node create-admin.js change-password <user>
# (prompts without echo, and revokes that admin's existing sessions).
# Leave empty to create no accounts (the admin panel will be unreachable).
# The value below is a placeholder that the policy DELIBERATELY REJECTS, so an
# unedited .env cannot create a weak admin. Replace it with a long unique
# password from a password manager.
ADMIN_SEED=admin:CHANGE_ME_please

# ── Runtime ────────────────────────────────────────────────────────
# Host port for the web UI.
WEB_PORT=8080

# ── Security ───────────────────────────────────────────────────────
# Browser origins allowed to make credentialed API calls, comma-separated.
# REQUIRED in production: without it only localhost dev origins are allowed,
# so a deployed frontend on its own domain would be refused by CORS.
# Example: ALLOWED_ORIGINS=https://zurii.com,https://www.zurii.com
# Never use `*` here — the API serves credentialed admin requests.
ALLOWED_ORIGINS=

# Number of trusted reverse-proxy hops in front of the backend, or empty to
# trust none. In the bundled Compose stack nginx is the only hop, so `1` is
# correct and docker-compose.yml already sets it. Leave EMPTY when the backend
# is exposed directly: trusting X-Forwarded-For on a directly reachable server
# lets any caller spoof their IP and slip past the rate limits.
TRUST_PROXY=

# Keep `development` when serving over plain HTTP (including localhost).
# `production` marks the refresh-token cookie Secure, so browsers refuse to
# store it over HTTP and admin login silently fails to stay signed in.
# Switch to `production` only behind HTTPS.
NODE_ENV=development

# Leave EMPTY so the SPA calls same-origin /api/* and nginx proxies it.
# Set to an absolute URL (https://api.example.com) only when the backend runs
# on a different origin. Baked in at image build time — changing it needs
# `docker compose build frontend`.
VITE_API_URL=
